{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "VTManager 主窗口默认权限",
  "windows": ["main", "pip-*"],
  "permissions": [
    "core:default",
    "core:window:allow-is-fullscreen",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-webview-close",
    "dialog:default"
  ]
}
