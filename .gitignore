# ---------- 依赖目录 ----------
node_modules/
src-tauri/target/
venv/
.venv/
__pycache__/

# ---------- 构建产物 ----------
dist/
release/
release-windows/*.exe
release-windows/*.msi
release-windows/output/

# ---------- 二进制依赖（需自备，见 bin/README.md） ----------
bin/ffmpeg
bin/ffprobe

# ---------- 资料库数据 / 数据库 / 测试素材 ----------
# 资料库根目录下的 .VTManager/ 存 vtmanager.db + covers/ + cache/ + .trash/
.VTManager/
*.db
*.db-wal
*.db-shm
testlib/

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example

# ---------- 日志 / 临时 / 校验产物 ----------
*.log
logs/
.verify-shots/
*.tmp

# ---------- 本地工具数据（非项目源码） ----------
.workbuddy/
.zcode/

# ---------- 系统文件 ----------
.DS_Store
.DS_Store?
._*
Thumbs.db
